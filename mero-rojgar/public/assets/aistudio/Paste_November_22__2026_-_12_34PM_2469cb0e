3.6 Mero Rewards: sponsor budgets and the immutable ledger
This is the most critical part of the database. Design it as double-entry accounting.
create table rewards.ledger_accounts (
  id uuid primary key default gen_random_uuid(),
  kind text not null check (kind in ('sponsor_funding','campaign_escrow_reserve','user_pending','user_available','user_paid_out','platform_revenue','fees','fraud_reversal')),
  owner_user_id uuid, owner_org_id uuid, campaign_id uuid,
  currency char(3) not null default 'NPR'
);

create table rewards.sponsor_campaigns (
  id uuid primary key default gen_random_uuid(),
  sponsor_org_id uuid not null references core.organizations(id),
  title text not null, creative_asset_id uuid, video_seconds int not null,
  sponsor_cost_per_completion bigint not null,      -- paisa
  user_reward_per_completion bigint not null,       -- paisa
  check (sponsor_cost_per_completion > user_reward_per_completion),
  funded_amount bigint not null default 0,
  reserved_amount bigint not null default 0,
  spent_amount bigint not null default 0,
  check (spent_amount + reserved_amount <= funded_amount),   -- cannot be overspent
  min_watch_ratio numeric(3,2) not null default 0.90,
  eligibility jsonb, terms_url text,
  status text not null default 'draft'
    check (status in ('draft','pending_review','funded','live','paused','exhausted','ended','rejected')),
  starts_at timestamptz, ends_at timestamptz
);

create table rewards.ledger_entries (
  id bigint generated always as identity primary key,
  txn_id uuid not null,                       -- groups the debit and credit lines
  account_id uuid not null references rewards.ledger_accounts(id),
  direction text not null check (direction in ('debit','credit')),
  amount bigint not null check (amount > 0),
  reason text not null,                        -- completion_approved, withdrawal_requested, fraud_reversal ...
  campaign_id uuid, completion_id uuid, withdrawal_id uuid,
  idempotency_key text not null,
  created_by text not null,                    -- 'system:approver' or admin user id
  created_at timestamptz not null default now(),
  unique (idempotency_key, account_id, direction)
);

-- Append-only: block UPDATE and DELETE for everyone including service roles
create function rewards.forbid_mutation() returns trigger language plpgsql as $$
begin raise exception 'ledger_entries is append-only'; end $$;
create trigger ledger_no_update before update or delete on rewards.ledger_entries
  for each row execute function rewards.forbid_mutation();

-- Every txn must balance
create function rewards.assert_balanced() returns trigger language plpgsql as $$
declare d bigint; c bigint;
begin
  select coalesce(sum(amount) filter (where direction='debit'),0),
         coalesce(sum(amount) filter (where direction='credit'),0)
    into d, c from rewards.ledger_entries where txn_id = new.txn_id;
  if d <> c then raise exception 'unbalanced txn %', new.txn_id; end if;
  return null;
end $$;
create constraint trigger ledger_balanced after insert on rewards.ledger_entries
  deferrable initially deferred for each row execute function rewards.assert_balanced();

create view rewards.user_balances as
  select a.owner_user_id as user_id,
    sum(case when a.kind='user_pending'   then (case e.direction when 'credit' then e.amount else -e.amount end) end) as pending,
    sum(case when a.kind='user_available' then (case e.direction when 'credit' then e.amount else -e.amount end) end) as available,
    sum(case when a.kind='user_paid_out'  then (case e.direction when 'credit' then e.amount else -e.amount end) end) as paid_out
  from rewards.ledger_entries e join rewards.ledger_accounts a on a.id = e.account_id
  group by a.owner_user_id;
